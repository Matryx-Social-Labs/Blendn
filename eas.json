{
  "cli": {
    "version": ">= 16.13.4",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "prebuildCommand": "npx expo prebuild --platform ios --no-install"
    },
    "production": {
      "autoIncrement": true,
      "prebuildCommand": "npx expo prebuild --platform ios --no-install"
    }
  },
  "submit": {
    "production": {}
  }
}

{
  "cli": {
    "version": ">= 16.13.4",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "ios": {
        "simulator": true
      }
    },

    "preview": {
      "distribution": "internal",
      "environment": "preview"
    },

    "staging": {
      "environment": "preview",
      "autoIncrement": true
    },

    "production": {
      "environment": "production",
      "autoIncrement": true
    }
  },

  "submit": {
    "staging": {
      "ios": {
        "ascAppId": "6757761059"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "6757761059"
      }
    }
  }
}

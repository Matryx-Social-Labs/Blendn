{
  "cli": {
    "version": ">= 16.13.4",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "ios": {
        "simulator": true
      }
    },
    "development-device": {
      "extends": "development",
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview"
    },
    "staging": {
      "environment": "preview",
      "autoIncrement": true,
      "ios": {
        "image": "macos-tahoe-26.6-xcode-27.0"
      },
      "android": {
        "buildType": "app-bundle",
        "buildArtifactPaths": ["android/app/build/outputs/mapping/release/mapping.txt"]
      }
    },
    "production": {
      "environment": "production",
      "autoIncrement": true,
      "ios": {
        "image": "macos-tahoe-26.6-xcode-27.0"
      },
      "android": {
        "buildType": "app-bundle",
        "buildArtifactPaths": ["android/app/build/outputs/mapping/release/mapping.txt"]
      }
    }
  },
  "submit": {
    "staging": {
      "ios": {
        "ascAppId": "6757761059"
      },
      "android": {
        "track": "internal"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "6757761059"
      },
      "android": {
        "track": "production",
        "releaseStatus": "draft"
      }
    }
  }
}

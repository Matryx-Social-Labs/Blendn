# EAS uploads by this file instead of the .gitignore files when it exists. It is
# all of them — the root one, and the nested ones scoped to their folders, at
# the end — minus one line, `/assets/fonts/satoshi/`: the Satoshi files are kept
# out of git (public repo, ITF licence) but must reach a build made from this
# checkout. __tests__/fonts.test.ts fails if a .gitignore rule is missing here.

# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

app-example

.env
.env.development

# Design assets (re-export from Figma if needed)
assets/figma/

# Dev tool config
.claude/
.env.local

# Sentry CLI auth token (sensitive)
android/sentry.properties
ios/sentry.properties

# Figma source and its PDF export. 183 MB and 202 MB — over GitHub's 100 MB
# hard limit, so committing them fails the push and needs history surgery to
# undo. They live in the design tool, not the app repo.
*.fig
Blendn.pdf

# The nested .gitignore files, which EAS stops reading once .easignore exists,
# with each rule scoped to its folder as git scopes it.

# .agents/skills/refero-design/.gitignore
.agents/skills/refero-design/**/.DS_Store
.agents/skills/refero-design/**/*.skill

# .idea/.gitignore
.idea/shelf/
.idea/workspace.xml

# android/.gitignore
android/**/.DS_Store
android/**/build/
android/**/.idea
android/**/.gradle
android/**/local.properties
android/**/*.iml
android/**/*.hprof
android/**/.cxx/
android/**/*.jsbundle

# ios/.gitignore
ios/**/.DS_Store
ios/**/build/
ios/**/*.pbxuser
!ios/**/default.pbxuser
ios/**/*.mode1v3
!ios/**/default.mode1v3
ios/**/*.mode2v3
!ios/**/default.mode2v3
ios/**/*.perspectivev3
!ios/**/default.perspectivev3
ios/**/xcuserdata
ios/**/*.xccheckout
ios/**/*.moved-aside
ios/**/DerivedData
ios/**/*.hmap
ios/**/*.ipa
ios/**/*.xcuserstate
ios/**/project.xcworkspace
ios/**/.xcode.env.local
ios/**/*.jsbundle
ios/Pods/
ios/**/*.xcworkspace

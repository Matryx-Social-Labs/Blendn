# Every EXPO_PUBLIC_ variable the app reads. Generated by grepping the source,
# not from memory — an earlier version of this file listed four of eight.
#
# THESE ARE NOT SECRETS, and cannot be made into secrets. Anything prefixed
# EXPO_PUBLIC_ is compiled into the JavaScript bundle, so anyone who installs
# the app from TestFlight or the App Store can unzip the .ipa and read them.
# That is true whether this repository is public or private — the repo was never
# the exposure, the binary is.
#
# The rule that follows: never put a real secret behind that prefix.
#
# For EAS builds these live in EAS environment variables (`preview` for the
# staging profile, `production` for production), not in this file and not in
# eas.json. See docs/RELEASING.md.
#
# Copy to .env for local development. .env is gitignored.

# ── Required ────────────────────────────────────────────────────────────────
# Which API this build talks to, and the only value that differs between
# staging and production.
#
# A build without this CRASHES BEFORE THE FIRST SCREEN — lib/apiClient.ts
# throws at module scope. It does not degrade and it does not show an error.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# ── Google ──────────────────────────────────────────────────────────────────
# OAuth client ids. Public by design; the iOS one is already in app.json and
# ios/blendn/Info.plist in the clear, because it has to be.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id.apps.googleusercontent.com

# Maps. Also extractable from the bundle, so it MUST be restricted in Google
# Cloud Console to the iOS bundle id (com.matryxsociallabs.blendn) and the
# Android package. That restriction, not secrecy, is what stops somebody
# spending your quota. Read by components/screens/EventDetailScreen.tsx.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── Optional ────────────────────────────────────────────────────────────────
# Sentry DSN. A DSN is designed to be public — it only permits writing events.
# Unset disables reporting, and lib/sentry.ts warns once in dev.
EXPO_PUBLIC_SENTRY_DSN=

# Silences debug logging. Set for release builds. Read by lib/logger.ts.
EXPO_PUBLIC_DISABLE_DEBUG_LOGS=

# Tags Sentry events. Read by lib/sentry.ts only.
EXPO_PUBLIC_APP_ENV=development

# ── Dead, pending removal ───────────────────────────────────────────────────
# Read by lib/photoUtils.ts, but the app has no Supabase dependency — photos
# are on Tigris. Listed so its presence is a known leftover rather than a
# mystery. Safe to leave unset.
EXPO_PUBLIC_SUPABASE_IMAGE_TRANSFORMS_ENABLED=

# Every variable the app reads, and what a build needs.
#
# THESE ARE NOT SECRETS, and cannot be made into secrets. Anything prefixed
# EXPO_PUBLIC_ is compiled into the JavaScript bundle, so anyone who downloads
# the app from TestFlight or the App Store can unzip the .ipa and read them.
# That is true whether this repository is public or private -- the repo was
# never the exposure, the binary is.
#
# The rule that follows: never put a real secret behind an EXPO_PUBLIC_ prefix.
#
# For EAS builds these live in EAS environment variables (`preview` for the
# staging profile, `production` for production), not in this file and not in
# eas.json. See docs/RELEASING.md. This file exists so there is a *manifest* --
# its absence is how the missing `env` block survived long enough to ship a
# build that crashed on launch.
#
# Copy to .env for local development. .env is gitignored.

# Which API this build talks to. The only value that differs between staging
# and production. Local dev usually points at staging or at localhost:3000.
EXPO_PUBLIC_API_BASE_URL=https://staging-api.blendn.app

# Google OAuth. Public by design -- the iOS one is already in app.json and in
# ios/blendn/Info.plist in the clear, because it has to be.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Google Maps. Also extractable from the bundle -- so it MUST be restricted in
# Google Cloud Console to the iOS bundle id (com.matryxsociallabs.blendn) and
# the Android package. That restriction, not secrecy, is what stops somebody
# spending your quota.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Silences debug logging. Set for release builds.
EXPO_PUBLIC_DISABLE_DEBUG_LOGS=

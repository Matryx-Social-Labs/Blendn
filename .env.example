# ===========================================
# Blendn Mobile App - Environment Variables
# ===========================================

# Google OAuth
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id.apps.googleusercontent.com

# ===========================================
# API Configuration
# ===========================================
# Production: https://api.blendn.app
# Development: http://localhost:3000 or http://<your-ip>:3000
# ===========================================
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# ===========================================
# Error Monitoring (Sentry)
# ===========================================
# Get this from your Sentry project settings -> Client Keys (DSN)
# Leave unset locally to disable reporting in dev builds
# EXPO_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
EXPO_PUBLIC_APP_ENV=development

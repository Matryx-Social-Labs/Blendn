+// Blendn patch — ported from expo/expo f1f1f976 ("do not crash if
+// ContentProvider doesn't provide mime type"), which shipped in v17 and not
+// in this SDK 53 line. The Android 16 photo picker (and Samsung OneUI 8 for
+// edited media) answers getType() with null; the original threw an uncaught
+// FailedToDeduceTypeException on the main thread and took the whole app down
+// on every library pick. Three sources, then a default rather than a throw.
+internal fun getType(contentResolver: ContentResolver, uri: Uri): String? {
+  val mimeFromCursor: () -> String? = {
+    try {
+      contentResolver
+        .query(uri, arrayOf(android.provider.DocumentsContract.Document.COLUMN_MIME_TYPE), null, null, null)
+        ?.use { cursor ->
+          if (cursor.moveToFirst()) {
+            val columnIndex = cursor.getColumnIndex(android.provider.DocumentsContract.Document.COLUMN_MIME_TYPE)
+            if (columnIndex != -1 && !cursor.isNull(columnIndex)) cursor.getString(columnIndex) else null
+          } else {
+            null
+          }
+        }
+    } catch (e: Exception) {
+      null
+    }
+  }
+
+  return contentResolver.getType(uri)
+    ?: mimeFromCursor()
     ?: getTypeFromFileUrl(uri.toString())
-    ?: throw FailedToDeduceTypeException()
